FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    GROK2API_API_ONLY=1 \
    GROK2API_HOST=0.0.0.0 \
    GROK2API_PORT=3000 \
    GROK2API_OPEN_BROWSER=0 \
    GROK2API_STORE_BACKEND=hybrid \
    GROK2API_WORKERS=2

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-api.txt /app/requirements-api.txt
RUN python -m pip install --no-cache-dir -U pip setuptools wheel \
    && python -m pip install --no-cache-dir -r /app/requirements-api.txt

COPY . /app
RUN test ! -e /app/grok-build-auth \
    && test ! -e /app/turnstile-solver \
    && test ! -e /app/grok_build_adapter.py \
    && test ! -e /app/registration_worker.py \
    && python -c "import app, config; assert config.API_ONLY; print('build-check', app.APP_VERSION)"

EXPOSE 3000

VOLUME ["/app/data"]

CMD ["python", "app.py"]
